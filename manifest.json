{
  "manifest_version": 3,
  "name": "VEIL — Private AI",
  "short_name": "VEIL",
  "version": "1.2.0",
  "description": "Replaces your private details with placeholders before they reach any AI chat, and restores them locally in the replies.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VEIL",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/bridge-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/types.js",
        "lib/names.js",
        "lib/vendor/libphonenumber-max.js",
        "lib/phone.js",
        "lib/ids.js",
        "lib/topics.js",
        "lib/urdu.js",
        "lib/hindi.js",
        "lib/fakenames.js",
        "lib/dict.js",
        "lib/detect.js",
        "lib/tokens.js",
        "lib/sites.js",
        "lib/settings.js",
        "content/dom.js",
        "content/ui.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open the VEIL panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
